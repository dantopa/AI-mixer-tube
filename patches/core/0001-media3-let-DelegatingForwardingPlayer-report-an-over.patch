From: Claude <noreply@anthropic.com>
Date: Wed, 30 Sep 2026 01:08:48 +0000
Subject: [PATCH 1/2] media3: let DelegatingForwardingPlayer report an
 overridden position/duration and reroute session seeks

While an AI-DJ transition window is the audible player the delegate is the rendered-window player, whose
timeline means nothing to the MediaSession/notification. Default off: with no override set every method is
the ForwardingPlayer one.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LjDCXJJeuBALofdjqC8qgu

diff --git a/media/media3/src/main/java/com/maxrave/media3/exoplayer/DelegatingForwardingPlayer.kt b/media/media3/src/main/java/com/maxrave/media3/exoplayer/DelegatingForwardingPlayer.kt
index acea4d7..3895e48 100644
--- a/media/media3/src/main/java/com/maxrave/media3/exoplayer/DelegatingForwardingPlayer.kt
+++ b/media/media3/src/main/java/com/maxrave/media3/exoplayer/DelegatingForwardingPlayer.kt
@@ -331,6 +331,45 @@ internal class DelegatingForwardingPlayer(
         }
     }
 
+    // ========== DJ window position override ==========
+    // While a DJ transition window is the audible player, the delegate is the rendered-window player, whose own
+    // timeline (0..window length) means nothing to the session/notification. These overrides report the
+    // INCOMING track's position and duration instead, and route session seeks back to the adapter.
+
+    class SessionPositionOverride(
+        val position: () -> Long,
+        val duration: () -> Long,
+    )
+
+    @Volatile
+    var positionOverride: SessionPositionOverride? = null
+
+    /** Called instead of seeking the window player when a session seek arrives while [positionOverride] is set. */
+    var overrideSeekHandler: ((Long) -> Unit)? = null
+
+    override fun getCurrentPosition(): Long = positionOverride?.position?.invoke() ?: super.getCurrentPosition()
+
+    override fun getContentPosition(): Long = positionOverride?.position?.invoke() ?: super.getContentPosition()
+
+    override fun getDuration(): Long = positionOverride?.duration?.invoke() ?: super.getDuration()
+
+    override fun getContentDuration(): Long = positionOverride?.duration?.invoke() ?: super.getContentDuration()
+
+    override fun getBufferedPosition(): Long = positionOverride?.duration?.invoke() ?: super.getBufferedPosition()
+
+    override fun seekTo(positionMs: Long) {
+        val handler = overrideSeekHandler
+        if (positionOverride != null && handler != null) handler(positionMs) else super.seekTo(positionMs)
+    }
+
+    override fun seekTo(
+        mediaItemIndex: Int,
+        positionMs: Long,
+    ) {
+        val handler = overrideSeekHandler
+        if (positionOverride != null && handler != null) handler(positionMs) else super.seekTo(mediaItemIndex, positionMs)
+    }
+
     // ========== Transport Intent Overrides ==========
     // MediaController surfaces (notification, Bluetooth, headset, Android Auto) land here.
     // Without these overrides the calls fall through to the raw delegate ExoPlayer: audio
