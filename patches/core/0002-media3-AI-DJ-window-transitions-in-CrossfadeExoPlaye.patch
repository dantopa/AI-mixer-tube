+    // ========== DJ mode (window transitions) ==========
+    // All logic lives in :djAndroid (DjEngine, DjTransitionRunner, TransitionController). This section is only the
+    // adapter's side of the seam: the guards, the DjPlayerPort, and the synchronous abort hooks. With `dj == null`
+    // or DJ disabled none of it does anything.
+
+    @Volatile
+    private var djRunner: DjTransitionRunner? = null
+    private var djLastContext: DjQueueContext? = null
+
+    /** Why DJ mode must sit this transition out, or null. Mirrors (and adds to) the crossfade guards. */
+    private fun djBlockedReason(): String? =
+        when {
+            isCastActive -> "casting"
+            crossfadeSuppressed -> "listen together"
+            internalRepeatMode == PlayerConstants.REPEAT_MODE_ONE -> "repeat one"
+            isCurrentTrackVideo() || isNextTrackVideo() -> "video"
+            internalPlaybackSpeed != 1f || internalPlaybackPitch != 1f -> "playback speed/pitch"
+            isWithinAlbum() -> "album"
+            else -> null
+        }
+
+    /** Called from the 50 ms poll: keeps the engine's (current, next) context fresh and starts a prepared window when due. */
+    private fun djPollTick(
+        player: ExoPlayer,
+        positionMs: Long,
+    ) {
+        val hooks = dj ?: return
+        if (!hooks.isEnabled) return
+        val currentId = playlist.getOrNull(localCurrentMediaItemIndex)?.mediaId ?: return
+        if (!isCrossfading) {
+            val nextId = if (hasNextMediaItem()) playlist.getOrNull(getNextMediaItemIndex())?.mediaId?.takeIf { it != currentId } else null
+            val ctx = DjQueueContext(currentId, nextId, djBlockedReason())
+            if (ctx != djLastContext) {
+                djLastContext = ctx
+                hooks.onQueueContext(ctx)
+                // A window prepared for another pair is dead weight.
+                djRunner?.takeIf { !it.isRunning && (it.prepared.fromId != currentId || it.prepared.toId != nextId) }?.let { djDiscardPrepared() }
+            }
+            // Blocked (cast, repeat one, video...): a window prepared earlier must not hold the plain crossfade back.
+            if (ctx.blockedReason != null) djDiscardPrepared()
+            val runner = djRunner ?: return
+            if (!runner.isRunning && !runner.prepared.holdsCrossfadeAt(positionMs)) {
+                // The outgoing track is already past the window's start: too late, the plain crossfade takes over.
+                hooks.consumed(runner.prepared, "missed the trigger")
+                djDiscardPrepared()
+                return
+            }
+            if (ctx.blockedReason == null && !runner.isRunning && !runner.isDone && player.isPlaying && runner.isWindowReady &&
+                runner.prepared.isTriggeredAt(positionMs, hooks.calibrator.startLatencyMs)
+            ) {
+                currentPlayer?.skipSilenceEnabled = false
+                if (!runner.start()) {
+                    hooks.consumed(runner.prepared, "start refused")
+                    djDiscardPrepared()
+                }
+            }
+        }
+    }
+
+    /** True while a plain crossfade must wait: a DJ window is ready (or running) for this pair and its moment has not passed. */
+    private fun djHoldsCrossfade(positionMs: Long): Boolean {
+        val hooks = dj ?: return false
+        if (!hooks.isEnabled) return false
+        val runner = djRunner ?: return false
+        return runner.isRunning || (!runner.isDone && runner.prepared.holdsCrossfadeAt(positionMs))
+    }
+
+    private fun djUiPositionMs(): Long? = djRunner?.takeIf { it.isRunning }?.uiPositionMs()
+
+    private fun djOnPrepared(prepared: org.simpmusic.dj.android.PreparedTransition) {
+        val hooks = dj ?: return
+        if (isCrossfading || isCastActive) return
+        djDiscardPrepared()
+        val runner = DjTransitionRunner(djPort, prepared, hooks, coroutineScope)
+        if (runner.prepareWindow()) djRunner = runner else hooks.consumed(prepared, "window player setup failed")
+    }
+
+    private fun djDiscardPrepared() {
+        val r = djRunner ?: return
+        if (r.isRunning) return
+        djRunner = null
+        r.discard()
+    }
+
+    /**
+     * Ends a running DJ transition SYNCHRONOUSLY, before the caller cancels the crossfade job / releases players.
+     * Afterwards the adapter is in exactly the state a cancelled crossfade leaves: incoming = [secondaryPlayer],
+     * ForwardingPlayer delegate on it. Before the commit point nothing had changed, so there is nothing to adopt.
+     */
+    private fun djAbortInternal() {
+        val runner = djRunner ?: return
+        if (!runner.isRunning) return
+        djRunner = null
+        val result = runner.abort()
+        dj?.consumed(runner.prepared, "interrupted")
+        djRestoreAfterAbort(result)
+    }
+
+    private fun djRestoreAfterAbort(result: AbortResult?) {
+        forwardingPlayer.positionOverride = null
+        forwardingPlayer.overrideSeekHandler = null
+        currentPlayer?.skipSilenceEnabled = internalSkipSilence
+        if (result != null && result.committed) {
+            val next = secondaryPlayer ?: return
+            forwardingPlayer.swapDelegate(next)
+            next.skipSilenceEnabled = internalSkipSilence
+            if (!result.incomingPlaying && internalPlayWhenReady) next.playWhenReady = true
+        }
+    }
+
+    private val djPort =
+        object : DjPlayerPort {
+            override fun currentPlayer(): ExoPlayer? = this@CrossfadeExoPlayerAdapter.currentPlayer
+
+            override fun userVolume(): Float = internalVolume
+
+            override fun createWindowPlayer(): ExoPlayer {
+                val pwf = createExoPlayerInstance()
+                pwf.filter.enabled = false
+                pwf.player.skipSilenceEnabled = false
+                return pwf.player
+            }
+
+            override fun incomingMetadata(): MediaItem? = playlist.getOrNull(getNextMediaItemIndex())?.toMedia3MediaItem()
+
+            override fun commitToIncoming(
+                seekSourceMs: Long,
+                windowPlayer: ExoPlayer,
+                uiPosition: () -> Long?,
+            ): ExoPlayer? {
+                if (isCrossfading || isCastActive || !hasNextMediaItem()) return null
+                val nextIndex = getNextMediaItemIndex()
+                val nextItem = playlist.getOrNull(nextIndex) ?: return null
+                val prepared = djRunner?.prepared
+                if (nextItem.mediaId != prepared?.toId) return null
+
+                val cached = precachedPlayers.remove(nextItem.mediaId)
+                val nextPlayer: ExoPlayer
+                val nextFilter: CrossfadeFilterAudioProcessor?
+                if (cached != null) {
+                    nextPlayer = cached.player
+                    nextFilter = cached.filter
+                } else {
+                    val pwf = createExoPlayerInstance()
+                    nextPlayer = pwf.player
+                    nextFilter = pwf.filter
+                    nextPlayer.setMediaItem(nextItem.toMedia3MediaItem())
+                    nextPlayer.prepare()
+                }
+                // Parked silently at the source position it must hold when it takes over from the window.
+                nextPlayer.setSeekParameters(SeekParameters.EXACT)
+                nextPlayer.skipSilenceEnabled = false
+                nextPlayer.volume = 0f
+                nextPlayer.playWhenReady = false
+                nextPlayer.seekTo(seekSourceMs)
+
+                secondaryPlayer = nextPlayer
+                secondaryPlayerFilter = nextFilter
+                setupPlayerListenerInternal(nextPlayer)
+
+                forwardingPlayer.positionOverride =
+                    DelegatingForwardingPlayer.SessionPositionOverride(
+                        position = { uiPosition() ?: prepared?.plan?.entryPointMs ?: 0L },
+                        duration = { nextPlayer.duration.takeIf { it > 0 } ?: prepared?.toDurationMs ?: 0L },
+                    )
+                forwardingPlayer.overrideSeekHandler = { ms -> seekTo(ms) }
+                forwardingPlayer.swapDelegate(windowPlayer)
+
+                requestAudioFocusInternal()
+                forwardingPlayer.suppressPlaybackEnded = false
+                crossfadeFromIndex = localCurrentMediaItemIndex
+                localCurrentMediaItemIndex = nextIndex
+                setCrossfading(true)
+                listeners.forEach {
+                    it.onMediaItemTransition(nextItem, PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_AUTO)
+                }
+                forwardingPlayer.notifyMediaItemChanged()
+                return nextPlayer
+            }
+
+            override fun onWindowRetired() {
+                val next = secondaryPlayer ?: return
+                forwardingPlayer.positionOverride = null
+                forwardingPlayer.overrideSeekHandler = null
+                forwardingPlayer.swapDelegate(next)
+            }
+
+            override fun onFinished() {
+                val runner = djRunner ?: return
+                djRunner = null
+                val next = secondaryPlayer
+                forwardingPlayer.positionOverride = null
+                forwardingPlayer.overrideSeekHandler = null
+                if (next == null) return
+                forwardingPlayer.swapDelegate(next)
+                dj?.consumed(runner.prepared, "DJ mix done")
+                finalizeCrossfade(localCurrentMediaItemIndex, next)
+            }
+
+            override fun onFailed(
+                reason: String,
+                result: AbortResult,
+            ) {
+                val runner = djRunner
+                djRunner = null
+                if (runner != null) dj?.consumed(runner.prepared, "fallback: $reason")
+                Logger.w(TAG, "DJ transition failed ($reason), committed=${result.committed}")
+                djRestoreAfterAbort(result)
+                if (!result.committed) return
+                val next = secondaryPlayer ?: return
+                if (next.playerError != null) {
+                    // The incoming deck never came up: reload the track where the mix had got to.
+                    val index = localCurrentMediaItemIndex
+                    setCrossfading(false)
+                    crossfadeFromIndex = -1
+                    secondaryPlayer = null
+                    secondaryPlayerFilter = null
+                    next.release()
+                    loadAndPlayTrackInternal(index, result.incomingPositionMs ?: 0L, internalPlayWhenReady)
+                    return
+                }
+                finalizeCrossfade(localCurrentMediaItemIndex, next)
+            }
+
+            override fun log(message: String) {
+                Logger.d(TAG, message)
+            }
+        }
